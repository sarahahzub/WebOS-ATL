Date: Sat, 17 Oct 2026 22:12:18 +0530
Subject: [PATCH 30/42] tv: framework dialogs show their content:
 AlertDialog.Builder.setView keeps the view in the native content box after
 the list (nativeSetView),
 Builder.setView(int)/setOnDismissListener/setOnKeyListener/setSingleChoiceItems/setAdapter/getContext,
 Dialog.getLayoutInflater and setOnKeyListener - FilmPlus link menu was an
 empty card, CloudStream home-provider picker aborted

---
 .../app/android_app_AlertDialog.c             | 16 +++++++
 src/api-impl/android/app/AlertDialog.java     | 44 ++++++++++++++++++-
 src/api-impl/android/app/Dialog.java          | 11 ++++-
 3 files changed, 69 insertions(+), 2 deletions(-)

diff --git a/src/api-impl-jni/app/android_app_AlertDialog.c b/src/api-impl-jni/app/android_app_AlertDialog.c
index 90fea60d..ba79c472 100644
--- a/src/api-impl-jni/app/android_app_AlertDialog.c
+++ b/src/api-impl-jni/app/android_app_AlertDialog.c
@@ -63,9 +63,25 @@ JNIEXPORT void JNICALL Java_android_app_AlertDialog_nativeConstruct(JNIEnv *env,
 	gtk_box_append(content_area, gtk_widget_get_parent(GTK_WIDGET(_PTR(button_negative_ptr))));
 	gtk_box_append(content_area, gtk_widget_get_parent(GTK_WIDGET(_PTR(button_neutral_ptr))));
 
+	/* the decor wrapper set by Dialog.nativeInit; AlertDialog.setView() puts it back after the list */
+	GtkWidget *decor = gtk_window_get_child(dialog);
+	if (decor)
+		g_object_set_data_full(G_OBJECT(dialog), "atl-decor", g_object_ref(decor), g_object_unref);
+
 	gtk_window_set_child(dialog, GTK_WIDGET(content_area));
 }
 
+JNIEXPORT void JNICALL Java_android_app_AlertDialog_nativeSetView(JNIEnv *env, jobject this, jlong ptr)
+{
+	GtkWindow *dialog = GTK_WINDOW(_PTR(ptr));
+	GtkWidget *decor = g_object_get_data(G_OBJECT(dialog), "atl-decor");
+	GtkWidget *list = g_object_get_data(G_OBJECT(dialog), "list");
+	if (!decor || !list || gtk_widget_get_parent(decor))
+		return;
+	gtk_box_insert_child_after(GTK_BOX(gtk_widget_get_parent(list)), decor, list);
+	gtk_widget_set_vexpand(decor, TRUE);
+}
+
