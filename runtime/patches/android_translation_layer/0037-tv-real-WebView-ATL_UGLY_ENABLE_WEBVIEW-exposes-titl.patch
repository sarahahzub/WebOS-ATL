diff --git a/src/api-impl/android/webkit/CookieManager.java b/src/api-impl/android/webkit/CookieManager.java
index e7260101..5d4466f6 100644
--- a/src/api-impl/android/webkit/CookieManager.java
+++ b/src/api-impl/android/webkit/CookieManager.java
@@ -43,10 +43,20 @@ public class CookieManager {
 	public void flush() {}
 
 	public String getCookie(String url) {
+		if (WebView.REAL && url != null) {
+			String c = native_getCookie(url.contains("://") ? url : "https://" + url);
+			return c == null || c.isEmpty() ? null : c;
+		}
 		return "";
 	}
 
-	public void setCookie(String url, String value) {}
+	public void setCookie(String url, String value) {
+		if (WebView.REAL && url != null && value != null)
+			native_setCookie(url.contains("://") ? url : "https://" + url, value);
+	}
+
+	private static native String native_getCookie(String url);
+	private static native void native_setCookie(String url, String value);
 
 	public void setAcceptCookie(boolean accept) {}
 
