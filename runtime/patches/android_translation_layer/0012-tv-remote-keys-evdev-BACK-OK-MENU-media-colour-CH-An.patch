 src/api-impl-jni/app/android_app_Activity.h |  2 +
 src/api-impl-jni/widgets/WrapperWidget.c    | 89 ++++++++++++++++++++-
 src/api-impl/android/app/Activity.java      | 35 +++++++-
 src/main-executable/main.c                  |  1 +
