 import java.util.List;
 import java.util.Map;
 
-public class Activity extends ContextThemeWrapper implements Window.Callback, LayoutInflater.Factory2 {
+public class Activity extends ContextThemeWrapper implements Window.Callback, LayoutInflater.Factory2, KeyEvent.Callback {
 	private final static String TAG = "Activity";
 
 	public static final int RESULT_CANCELED = 0;
@@ -653,7 +653,40 @@ public class Activity extends ContextThemeWrapper implements Window.Callback, La
 		finish();
 	}
 
+	/* Android: Window -> view hierarchy -> KeyEvent.dispatch(this). In ATL the view hierarchy already had the key
+	 * through GTK (WrapperWidget controllers), so this only sees keys no view consumed. */
 	public boolean dispatchKeyEvent(KeyEvent event) {
+		onUserInteraction();
+		return event.dispatch(this, null, this);
+	}
+
+	public void onUserInteraction() {}
+
+	public boolean onKeyDown(int keyCode, KeyEvent event) {
+		if (keyCode == KeyEvent.KEYCODE_BACK) {
+			event.startTracking();
+			return true;
+		}
+		return false;
+	}
+
+	public boolean onKeyUp(int keyCode, KeyEvent event) {
+		if (keyCode == KeyEvent.KEYCODE_BACK && !event.isCanceled()) {
+			onBackPressed();
+			return true;
+		}
+		return false;
+	}
+
+	public boolean onKeyLongPress(int keyCode, KeyEvent event) {
+		return false;
+	}
+
+	public boolean onKeyMultiple(int keyCode, int repeatCount, KeyEvent event) {
+		return false;
+	}
+
+	public boolean onKeyShortcut(int keyCode, KeyEvent event) {
 		return false;
 	}
 
