diff --git a/src/api-impl/android/app/Dialog.java b/src/api-impl/android/app/Dialog.java
index 1f4c3c65..278cd410 100644
--- a/src/api-impl/android/app/Dialog.java
+++ b/src/api-impl/android/app/Dialog.java
@@ -1,5 +1,7 @@
 package android.app;
 
+import android.view.KeyEvent;
+
 import android.R;
 import android.content.Context;
 import android.content.DialogInterface;
@@ -77,9 +79,42 @@ public class Dialog implements Window.Callback, DialogInterface {
 
 	public void setOwnerActivity(Activity activity) {}
 
-	public void setCancelable(boolean cancelable) {}
+	private boolean cancelable = true;
+	private OnCancelListener onCancelListener;
+
+	public void setCancelable(boolean cancelable) {
+		this.cancelable = cancelable;
+	}
+
+	public void setOnCancelListener(OnCancelListener onCancelListener) {
+		this.onCancelListener = onCancelListener;
+	}
+
+	public void onBackPressed() {
+		if (cancelable)
+			cancel();
+	}
+
+	public boolean dispatchKeyEvent(KeyEvent event) {
+		if (event.getKeyCode() == KeyEvent.KEYCODE_BACK || event.getKeyCode() == KeyEvent.KEYCODE_ESCAPE) {
+			if (event.getAction() == KeyEvent.ACTION_UP && !event.isCanceled())
+				onBackPressed();
+			return true;
+		}
+		if (event.getAction() == KeyEvent.ACTION_DOWN)
+			return onKeyDown(event.getKeyCode(), event);
+		if (event.getAction() == KeyEvent.ACTION_UP)
+			return onKeyUp(event.getKeyCode(), event);
+		return false;
+	}
+
+	public boolean onKeyDown(int keyCode, KeyEvent event) {
+		return false;
+	}
 
-	public void setOnCancelListener(OnCancelListener onCancelListener) {}
+	public boolean onKeyUp(int keyCode, KeyEvent event) {
+		return false;
+	}
 
 	public void setOnDismissListener(OnDismissListener onDismissListener) {
 		this.onDismissListener = onDismissListener;
@@ -214,6 +249,8 @@ public class Dialog implements Window.Callback, DialogInterface {
 
 	@Override
 	public void cancel() {
+		if (onCancelListener != null)
+			onCancelListener.onCancel(this);
 		dismiss();
 	}
 
