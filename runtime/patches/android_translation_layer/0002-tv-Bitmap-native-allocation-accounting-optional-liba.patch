diff --git a/src/api-impl/android/graphics/Bitmap.java b/src/api-impl/android/graphics/Bitmap.java
index 436095b2..110b5526 100644
--- a/src/api-impl/android/graphics/Bitmap.java
+++ b/src/api-impl/android/graphics/Bitmap.java
@@ -5,6 +5,8 @@ import android.util.DisplayMetrics;
 import java.io.IOException;
 import java.io.OutputStream;
 import java.nio.Buffer;
+import java.util.concurrent.atomic.AtomicLong;
+import dalvik.system.VMRuntime;
 
 /*
  * Bitmap is implemented as GdkTexture or GtkSnapshot. It can only be one of the two at a time.
@@ -50,6 +52,35 @@ public final class Bitmap implements Parcelable {
 	private boolean recycled = false;
 	boolean mutable = true;
 
+	// --- native memory accounting (see armhf/patches/bitmap-native-accounting.py) ---
+	private static final long NATIVE_CAP = 192L * 1024 * 1024; // live bitmap bytes before we force a GC
+	private static final AtomicLong liveNative = new AtomicLong();
+	private static volatile long lastForcedGc = 0;
+	private long accounted = 0;
+
+	private void accountNative() {
+		long n = (long) height * stride;
+		if (n <= 0) return;
+		accounted = n;
+		VMRuntime.getRuntime().registerNativeAllocation(n);
+		if (liveNative.addAndGet(n) > NATIVE_CAP) {
+			long now = System.nanoTime();
+			if (now - lastForcedGc > 300_000_000L) { // at most ~3x/s
+				lastForcedGc = now;
+				Runtime.getRuntime().gc();
+				System.runFinalization();
+			}
+		}
+	}
+
+	private void unaccountNative() {
+		long n = accounted;
+		if (n == 0) return;
+		accounted = 0;
+		liveNative.addAndGet(-n);
+		VMRuntime.getRuntime().registerNativeFree(n);
+	}
+
 	Bitmap(long texture) {
 		this(native_get_width(texture), native_get_height(texture), Config.ARGB_8888);
 		this.texture = texture;
@@ -61,6 +92,7 @@ public final class Bitmap implements Parcelable {
 		this.height = height;
 		int stride = width * config.bytes_per_pixel;
 		this.stride = (stride + 3) & ~3; // 4-byte alignment
+		accountNative();
 	}
 
 	public static Bitmap createBitmap(int width, int height, Config config) {
@@ -145,11 +177,12 @@ public final class Bitmap implements Parcelable {
 		}
 	}
 
-	public void recycle() {
+	public synchronized void recycle() {
 		native_recycle(texture, snapshot);
 		texture = 0;
 		snapshot = 0;
 		recycled = true;
+		unaccountNative();
 	}
 
 	public int getRowBytes() {
