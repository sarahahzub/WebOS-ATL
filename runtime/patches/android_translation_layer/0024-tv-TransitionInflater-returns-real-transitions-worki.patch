--- a/src/api-impl/android/transition/TransitionSet.java
+++ b/src/api-impl/android/transition/TransitionSet.java
@@ -1,8 +1,47 @@
 package android.transition;
 
+import java.util.ArrayList;
+
 public class TransitionSet extends Transition {
 
+	public static final int ORDERING_TOGETHER = 0;
+	public static final int ORDERING_SEQUENTIAL = 1;
+
+	private ArrayList<Transition> transitions = new ArrayList<>();
+	private int ordering = ORDERING_TOGETHER;
+
 	public TransitionSet addTransition(Transition transition) {
+		if (transition != null)
+			transitions.add(transition);
 		return this;
 	}
+
+	public TransitionSet removeTransition(Transition transition) {
+		transitions.remove(transition);
+		return this;
+	}
+
+	public int getTransitionCount() {
+		return transitions.size();
+	}
+
+	public Transition getTransitionAt(int index) {
+		return index < 0 || index >= transitions.size() ? null : transitions.get(index);
+	}
+
+	public TransitionSet setOrdering(int ordering) {
+		this.ordering = ordering;
+		return this;
+	}
+
+	public int getOrdering() {
+		return ordering;
+	}
+
+	@Override
+	public TransitionSet clone() {
+		TransitionSet t = (TransitionSet)super.clone();
+		t.transitions = new ArrayList<>(transitions);
+		return t;
+	}
 }
