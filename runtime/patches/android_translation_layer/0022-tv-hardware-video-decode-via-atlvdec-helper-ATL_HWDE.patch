 JNIEXPORT jlong JNICALL Java_android_media_MediaCodec_native_1constructor(JNIEnv *env, jobject this, jstring codec_name)
 {
 	const char *name = (*env)->GetStringUTFChars(env, codec_name, NULL);
@@ -250,6 +616,12 @@ JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1configure_1video(JN
 	ctx->video.extradata = extradata;
 	ctx->video.extradata_size = extradata_size;
 
+	if (surface_obj && hwdec_open(ctx, extradata, extradata_size,
+	                              SURFACE_VIEW_WIDGET(gtk_widget_get_first_child(_PTR(_GET_LONG_FIELD(surface_obj, "widget")))))) {
+		ctx->video.surface_view_widget = ctx->hw->widget;
+		return;
+	}
+
 	int i = 0;
 	while (1) {
 		const AVCodecHWConfig *config = avcodec_get_hw_config(codec_ctx->codec, i);
@@ -283,6 +655,8 @@ JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1start(JNIEnv *env,
 	struct ATL_codec_context *ctx = _PTR(codec);
 	AVCodecContext *codec_ctx = ctx->codec;
 
+	if (ctx->hw)
+		return;
 	if (avcodec_open2(codec_ctx, codec_ctx->codec, NULL) < 0) {
 		printf("Codec cannot be found");
 	}
@@ -298,6 +672,8 @@ JNIEXPORT jint JNICALL Java_android_media_MediaCodec_native_1queueInputBuffer(JN
 	struct ATL_codec_context *ctx = _PTR(codec);
 	AVCodecContext *codec_ctx = ctx->codec;
 	AVPacket *pkt = NULL;
+	if (ctx->hw)
+		return hwdec_queue(env, ctx->hw, buffer, presentationTimeUs);
 	if (buffer) { // buffer can be null if we're sending EOF
 		pkt = av_packet_alloc();
 		pkt->size = get_nio_buffer_size(env, buffer);
@@ -327,6 +703,8 @@ JNIEXPORT jint JNICALL Java_android_media_MediaCodec_native_1dequeueOutputBuffer
 {
 	struct ATL_codec_context *ctx = _PTR(codec);
 	AVCodecContext *codec_ctx = ctx->codec;
+	if (ctx->hw)
+		return hwdec_dequeue(env, ctx->hw, buffer, buffer_info);
 	AVFrame *frame = av_frame_alloc();
 	int ret;
 	jarray array_ref;
@@ -444,6 +822,10 @@ JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1releaseOutputBuffer
 	jbyte *array;
 	AVFrame *frame;
 
+	if (ctx->hw) {
+		hwdec_release(env, ctx->hw, buffer);
+		return;
+	}
 	if (ctx->codec->codec_type == AVMEDIA_TYPE_VIDEO) {
 		AVFrame **raw_buffer = get_nio_buffer(env, buffer, &array_ref, &array);
 		frame = *raw_buffer;
@@ -504,12 +886,34 @@ JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1releaseOutputBuffer
 JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1flush(JNIEnv *env, jobject this, jlong codec)
 {
 	struct ATL_codec_context *ctx = _PTR(codec);
+	if (ctx->hw) {
+		hwdec_clear(ctx->hw);
+		hw_send(ctx->hw, AVD_FLUSH, NULL, 0, NULL, 0, 0);
+		return;
+	}
 	avcodec_flush_buffers(ctx->codec);
 }
 
 JNIEXPORT void JNICALL Java_android_media_MediaCodec_native_1release(JNIEnv *env, jobject this, jlong codec)
 {
 	struct ATL_codec_context *ctx = _PTR(codec);
+	if (ctx->hw) {
+		struct hwdec *hw = ctx->hw;
+		ctx->hw = NULL;
+		hw_send(hw, AVD_CLOSE, NULL, 0, NULL, 0, 0);
+		pthread_mutex_lock(&hw->lock);
+		hw->closed = TRUE;
+		close(hw->fd);
+		hw->fd = -1;
+		pthread_mutex_unlock(&hw->lock);
+		hwdec_clear(hw);
+		free(hw->aus);
+		free(hw->csd);
+		hw->aus = NULL;
+		hw->csd = NULL;
+		fprintf(stderr, "ATL_HWDEC: released (%lu AUs fed)\n", hw->fed);
+		g_idle_add(hwdec_close_idle, hw);
+	}
 	if (ctx->codec->codec_type == AVMEDIA_TYPE_VIDEO && ctx->video.sws) {
 		sws_freeContext(ctx->video.sws);
 	}
