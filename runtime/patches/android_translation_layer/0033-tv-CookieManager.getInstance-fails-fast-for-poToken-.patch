From ee8536e8d6a6fc9280d7adf14cb8d0741cd5b4dc Mon Sep 17 00:00:00 2001
From: Kiro Agent <kiro-agent@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:12:18 +0530
Subject: [PATCH 33/42] tv: CookieManager.getInstance() fails fast for
 poToken/BotGuard WebView probes (no JS in ATL WebView) - SmartTube titles
 loaded forever on an unbounded CountDownLatch

---
 src/api-impl/android/webkit/CookieManager.java | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/api-impl/android/webkit/CookieManager.java b/src/api-impl/android/webkit/CookieManager.java
index 5e903784..e7260101 100644
--- a/src/api-impl/android/webkit/CookieManager.java
+++ b/src/api-impl/android/webkit/CookieManager.java
@@ -17,6 +17,16 @@ public class CookieManager {
 			throw new RuntimeException("CookieManager not yet fully implemented");
 		} catch (ClassNotFoundException e) {
 		}
+		// WebView probe of a poToken/BotGuard generator (SmartTube, NewPipe forks): fail as on a device without a
+		// WebView; ATL's WebView runs no JavaScript, so the generator would wait forever
+		if (System.getenv("ATL_UGLY_ENABLE_WEBVIEW") == null) {
+			StackTraceElement[] st = new Throwable().getStackTrace();
+			for (int i = 0; i < st.length && i < 10; i++) {
+				String c = String.valueOf(st[i].getClassName()).toLowerCase();
+				if (c.contains("potoken") || c.contains("botguard"))
+					throw new RuntimeException("WebView not available (ATL)");
+			}
+		}
 		return new CookieManager();
 	}
 
