From: Kiro Agent <kiro-agent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 13:37:56 +0530
Subject: [PATCH] tv: hardware decode protocol 2 (ATL_HWDEC): frame rate,
 colour and HDR metadata in OPEN; with a Starfish helper AUs go out at queue
 time and releaseOutputBuffer only sends the due time and pts; VP9 to the
 helper when its decoder takes it

---
 .../media/android_media_MediaCodec.c          | 180 ++++++++++++++----
 src/api-impl/android/media/MediaCodec.java    |  13 ++
 src/api-impl/android/media/MediaFormat.java   |   4 +
 3 files changed, 164 insertions(+), 33 deletions(-)

diff --git a/src/api-impl-jni/media/android_media_MediaCodec.c b/src/api-impl-jni/media/android_media_MediaCodec.c
index b5a3f12f..a9835c15 100644
--- a/src/api-impl-jni/media/android_media_MediaCodec.c
+++ b/src/api-impl-jni/media/android_media_MediaCodec.c
@@ -51,6 +51,9 @@ struct ATL_codec_context {
 	};
 	struct hwdec *hw; /* ATL_HWDEC: video goes to the atlvdec helper */
 	int hw_width, hw_height;
+	int hw_fps_milli, hw_standard, hw_transfer, hw_range; /* MediaFormat, for the helper's OPEN */
+	uint8_t hw_hdr[25];
+	int hw_hdr_len;
 };
 
 /* ---------------- ATL_HWDEC: hardware decode through the 32-bit atlvdec helper (gpu/atlvdec/proto.h) ---------------- */
@@ -60,7 +63,18 @@ struct avd_hdr {
 	uint32_t len;
 	int64_t pts_us;
 };
-enum { AVD_OPEN = 1, AVD_FEED = 2, AVD_AREA = 3, AVD_FLUSH = 4, AVD_CLOSE = 5, AVD_DUE = 6, AVD_RESULT = 16 };
+enum { AVD_OPEN = 1, AVD_FEED = 2, AVD_AREA = 3, AVD_FLUSH = 4, AVD_CLOSE = 5, AVD_DUE = 6, AVD_HELLO = 8, AVD_RESULT = 16 };
+
+/* protocol 2 OPEN (native/atlvdec/proto.h struct avd_open, 56 bytes); a protocol-1 helper reads the first 12 */
+struct avd_open2 {
+	uint32_t codec, width, height, flags, fps_milli;
+	uint8_t transfer, primaries, matrix, full_range, has_mastering, has_light_level, pad[2];
+	uint16_t primaries_xy[3][2], white_xy[2];
+	uint32_t max_luminance, min_luminance;
+	uint16_t max_cll, max_fall;
+};
+_Static_assert(sizeof(struct avd_open2) == 56, "avd_open layout");
+
 
 #define HW_WINDOW 4
 #define HW_MAX_AUS 24
@@ -93,6 +107,8 @@ struct hwdec {
 	uint8_t *prefix; /* non-VCL input (config) waiting for the next picture */
 	size_t prefix_len;
 	gboolean hevc;
+	gboolean vp9;   /* frames as they are: no Annex-B parsing, no csd */
+	gboolean ahead; /* protocol-2 helper: AUs at queue time, AVD_DUE with the frame's pts at release */
 	SurfaceViewWidget *widget;
 	int area[4];
 	gint64 last_area;
@@ -224,6 +240,60 @@ static void hwdec_clear(struct hwdec *hw)
 	hw->need_csd = hw->csd_len > 0;
 }
 
+/* the helper's AVD_RESULT within timeout_ms: status (msg filled), or -1000 without a reply */
+static int hw_result(int fd, int timeout_ms, char *msg, size_t n)
+{
+	struct {
+		struct avd_hdr h;
+		int32_t status;
+		char msg[60];
+	} r = {0};
+	size_t got = 0;
+	gint64 end = g_get_monotonic_time() + timeout_ms * 1000LL;
+	while (got < sizeof(r)) {
+		int left = (int)((end - g_get_monotonic_time()) / 1000);
+		struct pollfd p = {fd, POLLIN, 0};
+		if (left <= 0 || poll(&p, 1, left) <= 0)
+			break;
+		ssize_t k = read(fd, (char *)&r + got, sizeof(r) - got);
+		if (k <= 0)
+			break;
+		got += k;
+	}
+	r.msg[sizeof(r.msg) - 1] = 0;
+	snprintf(msg, n, "%s", got < sizeof(r) ? "no reply" : r.msg);
+	return got < sizeof(r) || r.h.type != AVD_RESULT ? -1000 : r.status;
+}
+
+/* MediaFormat COLOR_STANDARD / COLOR_TRANSFER / COLOR_RANGE / HDR_STATIC_INFO -> the helper's OPEN (ITU-T H.273) */
+static void hw_colour(const struct ATL_codec_context *ctx, struct avd_open2 *o)
+{
+	switch (ctx->hw_standard) {
+		case 1: o->primaries = 1, o->matrix = 1; break; /* BT709 */
+		case 2: o->primaries = 5, o->matrix = 5; break; /* BT601_PAL */
+		case 4: o->primaries = 6, o->matrix = 6; break; /* BT601_NTSC */
+		case 6: o->primaries = 9, o->matrix = 9; break; /* BT2020 */
+	}
+	switch (ctx->hw_transfer) {
+		case 1: o->transfer = 8; break;  /* LINEAR */
+		case 3: o->transfer = 1; break;  /* SDR_VIDEO */
+		case 6: o->transfer = 16; break; /* ST2084 (PQ, HDR10) */
+		case 7: o->transfer = 18; break; /* HLG */
+	}
+	o->full_range = ctx->hw_range == 1;
+	if (ctx->hw_hdr_len == 25 && ctx->hw_hdr[0] == 0) { /* type 0: ST 2086 + CTA-861.3, little-endian uint16 */
+		uint16_t v[12];
+		memcpy(v, ctx->hw_hdr + 1, sizeof(v));
+		for (int i = 0; i < 3; i++)
+			o->primaries_xy[i][0] = v[2 * i], o->primaries_xy[i][1] = v[2 * i + 1];
+		o->white_xy[0] = v[6], o->white_xy[1] = v[7];
+		o->max_luminance = v[8], o->min_luminance = v[9];
+		o->max_cll = v[10], o->max_fall = v[11];
+		o->has_mastering = v[8] || v[0] || v[6];
+		o->has_light_level = v[10] || v[11];
+	}
+}
+
