 	hwdec_check_area(hw);
 	return TRUE;
 }
@@ -303,12 +378,14 @@ static int hwdec_queue(JNIEnv *env, struct hwdec *hw, jobject buffer, jlong pts)
 		hw->eos = TRUE;
 		return 0;
 	}
-	if (hw->n_aus >= HW_MAX_AUS || hw->bytes > HW_MAX_BYTES)
