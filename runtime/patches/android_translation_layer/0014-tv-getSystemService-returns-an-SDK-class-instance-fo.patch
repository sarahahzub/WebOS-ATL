Subject: [PATCH 14/42] tv: getSystemService returns an SDK-class instance for
 every service ATL does not implement (was null), getSystemService(Class)
 without public ctors, getSystemServiceName

---
 src/api-impl/android/app/ContextImpl.java |  24 ++-
 src/api-impl/android/atl/ATLServices.java | 184 ++++++++++++++++++++++
 src/api-impl/meson.build                  |   1 +
 3 files changed, 206 insertions(+), 3 deletions(-)
 create mode 100644 src/api-impl/android/atl/ATLServices.java

diff --git a/src/api-impl/android/app/ContextImpl.java b/src/api-impl/android/app/ContextImpl.java
index fe60dade..00f08e4a 100644
--- a/src/api-impl/android/app/ContextImpl.java
+++ b/src/api-impl/android/app/ContextImpl.java
@@ -210,11 +210,17 @@ public final class ContextImpl extends Context {
 			case "download":
 				return new DownloadManager();
 			default:
-				Slog.e(TAG, "!!!!!!! getSystemService: case >" + name + "< is not implemented yet");
-				return null;
+				Object stub = android.atl.ATLServices.forName(name);
+				if (stub == null)
+					Slog.e(TAG, "!!!!!!! getSystemService: case >" + name + "< is not implemented yet");
+				return stub;
 		}
 	}
 
+	public String getSystemServiceName(Class<?> serviceClass) {
+		return android.atl.ATLServices.serviceNameFor(serviceClass);
+	}
+
 	@Override
 	public Object getSystemService(Class<?> serviceClass) throws InstantiationException, IllegalAccessException, InvocationTargetException {
 		if (serviceClass == LayoutInflater.class)
@@ -223,7 +229,19 @@ public final class ContextImpl extends Context {
 			return job_scheduler;
 		if (serviceClass == WindowManager.class)
 			return new WindowManagerImpl();
-		return serviceClass.getConstructors()[0].newInstance();
+		String name = android.atl.ATLServices.serviceNameFor(serviceClass);
+		if (name != null) {
+			Object o = getSystemService(name);
+			if (o != null && serviceClass.isInstance(o))
+				return o;
+		}
+		if (serviceClass.getConstructors().length > 0) {
+			try {
+				return serviceClass.getConstructors()[0].newInstance();
+			} catch (ReflectiveOperationException | IllegalArgumentException e) {
+			}
+		}
+		return android.atl.ATLServices.forClass(serviceClass);
 	}
 
 	@Override
