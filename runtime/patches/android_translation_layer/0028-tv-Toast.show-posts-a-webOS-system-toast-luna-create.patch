From 1691a90a6b13c120e9b2888d672856cc6ca44fe9 Mon Sep 17 00:00:00 2001
From: Kiro Agent <kiro-agent@users.noreply.github.com>
Date: Sat, 17 Oct 2026 17:36:45 +0530
Subject: [PATCH 28/42] tv: Toast.show() posts a webOS system toast (luna
 createToast; text from setText or the custom view's TextViews) - toasts were
 invisible on the TV

---
 src/api-impl/android/widget/Toast.java | 68 +++++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 2 deletions(-)

diff --git a/src/api-impl/android/widget/Toast.java b/src/api-impl/android/widget/Toast.java
index 9b494626..8030301f 100644
--- a/src/api-impl/android/widget/Toast.java
+++ b/src/api-impl/android/widget/Toast.java
@@ -9,6 +9,8 @@ import android.view.View;
 public class Toast {
 	private final Context mContext;
 	private String text;
+	private int duration;
+	private View view;
 
 	public Toast(Context context) {
 		mContext = context;
@@ -24,8 +26,70 @@ public class Toast {
 		return toast;
 	}
 
+	public void setText(CharSequence s) { text = String.valueOf(s); }
+
+	public void setText(int resId) { text = mContext.getString(resId); }
+
+	public void setDuration(int d) { duration = d; }
+
+	public int getDuration() { return duration; }
+
+	public View getView() { return view; }
+
+	private static void collect(View v, StringBuilder sb) {
+		if (v == null || v.getVisibility() != View.VISIBLE)
+			return;
+		if (v instanceof TextView) {
+			CharSequence t = ((TextView)v).getText();
+			if (t != null && t.length() > 0)
+				sb.append(sb.length() > 0 ? "\n" : "").append(t);
+		} else if (v instanceof android.view.ViewGroup) {
+			android.view.ViewGroup g = (android.view.ViewGroup)v;
+			for (int i = 0; i < g.getChildCount(); i++)
+				collect(g.getChildAt(i), sb);
+		}
+	}
+
+	private static String json(String t) {
+		StringBuilder b = new StringBuilder("\"");
+		for (char c : t.toCharArray()) {
+			if (c == '"' || c == '\\') b.append('\\').append(c);
+			else if (c < 0x20) b.append(String.format("\\u%04x", (int)c));
+			else b.append(c);
+		}
+		return b.append('"').toString();
+	}
+
+	/* webOS system toast (the TV has no notification daemon) */
+	private static void tvToast(final String t) {
+		if ("0".equals(System.getenv("ATL_TOAST")) || !new java.io.File("/usr/bin/luna-send").exists())
+			return;
+		new Thread(new Runnable() { public void run() {
+			try {
+				ProcessBuilder pb = new ProcessBuilder("/usr/bin/luna-send", "-n", "1", "luna://com.webos.notification/createToast",
+				                                       "{\"sourceId\":\"tld.ghar.atl\",\"message\":" + json(t.length() > 300 ? t.substring(0, 300) : t) + "}");
+				pb.environment().clear();
+				pb.environment().put("PATH", "/usr/bin:/bin:/usr/sbin:/sbin");
+				pb.redirectErrorStream(true);
+				Process pr = pb.start();
+				pr.getInputStream().close();
+				pr.waitFor();
+			} catch (Exception e) {
+				System.out.println("toast: luna-send failed: " + e);
+			}
+		}}, "atl-toast").start();
+	}
+
 	public void show() {
-		System.out.println("showing toast: " + text);
+		String t = text;
+		if ((t == null || t.equals("null")) && view != null) {
+			StringBuilder sb = new StringBuilder();
+			collect(view, sb);
+			t = sb.length() > 0 ? sb.toString() : null;
+		}
+		System.out.println("showing toast: " + t);
+		if (t != null)
+			tvToast(t);
 		Notification notification = new Notification.Builder(mContext).setContentText(text).build();
 		NotificationManager manager = (NotificationManager)mContext.getSystemService("notification");
 		int id = hashCode();
@@ -37,7 +101,7 @@ public class Toast {
 		}, 2000);
 	}
 
-	public void setView(View view) {}
+	public void setView(View view) { this.view = view; }
 
 	public void setGravity(int gravity, int xOffset, int yOffset) {}
 
