Subject: [PATCH 05/42] tv: Parcel.writeValue accepts any CharSequence (media3
 subtitle cues)

---
 src/api-impl/android/os/Parcel.java | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/api-impl/android/os/Parcel.java b/src/api-impl/android/os/Parcel.java
index 52bcfe8c..b75a0d82 100644
--- a/src/api-impl/android/os/Parcel.java
+++ b/src/api-impl/android/os/Parcel.java
@@ -844,6 +844,9 @@ public class Parcel {
 		} else if (value instanceof String) {
 			writeInt(8);
 			writeString((String)value);
+		} else if (value instanceof CharSequence) { // Spanned etc: keep the text only
+			writeInt(8);
+			writeString(value.toString());
 		} else if (value instanceof byte[]) {
 			writeInt(9);
 			writeByteArray((byte[])value);
